rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isStaff() {
      return isSignedIn() && (
        request.auth.token.email == 'dyanecayer1821@gmail.com' ||
        (exists(/databases/$(database)/documents/artifacts/vera-worldwide-v1/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/artifacts/vera-worldwide-v1/users/$(request.auth.uid)).data.role == 'staff')
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Blueprint Rule 1: Strict Path /artifacts/vera-worldwide-v1/users/{userId}
    match /artifacts/vera-worldwide-v1/users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && (
        request.resource.data.role == 'user' || request.auth.token.email == 'dyanecayer1821@gmail.com'
      );
      allow update: if isStaff() || (
        isOwner(userId) && request.resource.data.role == resource.data.role
      );
      allow delete: if isOwner(userId) || isStaff();
    }

    // Blueprint Rule 1: Public Data Path /artifacts/vera-worldwide-v1/public/data/...
    match /artifacts/vera-worldwide-v1/public/data/chat_logs/{chatId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
    }

    match /artifacts/vera-worldwide-v1/public/data/config/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /artifacts/vera-worldwide-v1/public/data/platform_stats/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /artifacts/vera-worldwide-v1/public/data/arcade_sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }
  }
}
